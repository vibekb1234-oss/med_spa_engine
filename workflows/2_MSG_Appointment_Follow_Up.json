      "id": "ms2000000-0000-0000-0000-000000000003",
      "name": "Get All Appointments",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [220, 200],
      "credentials": { "googleSheetsOAuth2Api": { "id": "YOUR_GSHEETS_CREDENTIAL_ID", "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "jsCode": "// --- Timezone-aware date math ---\nconst TZ = 'YOUR_CLINIC_TIMEZONE';\nfunction tzDateStr(d, tz, offsetDays = 0) {\n  const x = new Date(d);\n  x.setUTCDate(x.getUTCDate() + offsetDays);\n  return new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(x);\n}\n\nconst clients      = $('Get All Clients').all();\nconst appointments = $('Get All Appointments').all();\nconst now          = new Date();\nconst nowIso       = now.toISOString();\n\nconst todayStr     = tzDateStr(now, TZ, 0);\nconst yesterdayStr = tzDateStr(now, TZ, -1);\n\n// Build appointment map keyed by client email\nconst apptMap = {};\nfor (const item of appointments) {\n  const a = item.json;\n  if (!a['Client Email']) continue;\n  const email = a['Client Email'].toLowerCase().trim();\n  if (!apptMap[email]) apptMap[email] = [];\n  apptMap[email].push(a);\n}\n\nconst priorNotice48h  = [];\nconst priorNotice24h  = [];\nconst noShowRecovery  = [];\nconst inquiryFollowUp = [];\nconst postApptCheckIn = [];\n\nfor (const item of clients) {\n  const c = item.json;\n  if (!c['Client Email'] || (c['Opted Out'] || '').toLowerCase() === 'yes') continue;\n\n  const email  = c['Client Email'].toLowerCase().trim();\n  const status = (c['Status'] || '').trim();\n\n  // --- INQUIRY FOLLOW-UP ---\n  if (status === 'New Inquiry') {\n    const created = c['Created Date'] ? new Date(c['Created Date']) : null;\n    if (created && !isNaN(created)) {\n      const daysSince = Math.floor((now - created) / 86400000);\n      const lastFU    = c['Last Follow-Up Date'] ? new Date(c['Last Follow-Up Date']) : null;\n      const daysSinceFU = lastFU && !isNaN(lastFU) ? Math.floor((now - lastFU) / 86400000) : 999;\n      const fuCount   = parseInt(c['Follow-Up Count'] || 0);\n      if (daysSince >= 3 && daysSinceFU >= 3 && fuCount < 3) {\n        inquiryFollowUp.push({\n          clientEmail:  c['Client Email'].trim(),\n          clientName:   (c['Client Name'] || 'there').trim(),\n          service:      c['Service Interest'] || 'our services',\n          fuCount,\n          nowIso\n        });\n      }\n    }\n  }\n\n  const clientAppts = apptMap[email] || [];\n  for (const appt of clientAppts) {\n    const apptDate = appt['Appointment Date'] ? new Date(appt['Appointment Date']) : null;\n    if (!apptDate || isNaN(apptDate)) continue;\n\n    const hoursUntil  = (apptDate - now) / 3600000;\n    const apptStatus  = (appt['Status'] || '').trim();\n    const apptDateStr = tzDateStr(apptDate, TZ, 0);\n\n    // 48hr reminder — only if not already sent\n    if (apptStatus === 'Scheduled' && hoursUntil >= 44 && hoursUntil <= 52\n        && (appt['Pre-Appt Reminder Sent'] || '').toLowerCase() !== 'yes') {\n      priorNotice48h.push({\n        clientEmail: c['Client Email'].trim(),\n        clientName:  (c['Client Name'] || 'there').trim(),\n        service:     appt['Service'] || 'your appointment',\n        provider:    appt['Provider'] || 'your provider',\n        apptDate:    appt['Appointment Date'],\n        apptTime:    appt['Appointment Time'] || '',\n        nowIso\n      });\n    }\n\n    // 24hr reminder — requires 48hr sent AND 24hr NOT yet sent\n    if (apptStatus === 'Scheduled' && hoursUntil >= 20 && hoursUntil <= 28\n        && (appt['Pre-Appt Reminder Sent'] || '').toLowerCase() === 'yes'\n        && (appt['24hr Reminder Sent'] || '').toLowerCase() !== 'yes') {\n      priorNotice24h.push({\n        clientEmail: c['Client Email'].trim(),\n        clientName:  (c['Client Name'] || 'there').trim(),\n        service:     appt['Service'] || 'your appointment',\n        provider:    appt['Provider'] || 'your provider',\n        apptDate:    appt['Appointment Date'],\n        apptTime:    appt['Appointment Time'] || '',\n        nowIso\n      });\n    }\n\n    if (apptStatus === 'No-Show' && apptDateStr === yesterdayStr\n        && (appt['Post-Appt Follow-Up Sent'] || '').toLowerCase() !== 'yes') {\n      noShowRecovery.push({\n        clientEmail: c['Client Email'].trim(),\n        clientName:  (c['Client Name'] || 'there').trim(),\n        service:     appt['Service'] || 'your appointment',\n        apptDate:    appt['Appointment Date'],\n        nowIso\n      });\n    }\n\n    if (apptStatus === 'Completed' && apptDateStr === yesterdayStr\n        && (appt['Post-Appt Follow-Up Sent'] || '').toLowerCase() !== 'yes') {\n      postApptCheckIn.push({\n        clientEmail: c['Client Email'].trim(),\n        clientName:  (c['Client Name'] || 'there').trim(),\n        service:     appt['Service'] || 'your recent treatment',\n        provider:    appt['Provider'] || 'our team',\n        apptDate:    appt['Appointment Date'],\n        nowIso\n      });\n    }\n  }\n}\n\nconst allItems = [\n  ...priorNotice48h.map(i => ({ ...i, type: 'REMINDER_48H' })),\n  ...priorNotice24h.map(i => ({ ...i, type: 'REMINDER_24H' })),\n  ...noShowRecovery.map(i => ({ ...i, type: 'NO_SHOW' })),\n  ...inquiryFollowUp.map(i => ({ ...i, type: 'INQUIRY_FU' })),\n  ...postApptCheckIn.map(i => ({ ...i, type: 'POST_APPT' }))\n];\n\nif (allItems.length === 0) {\n  return [{ json: { type: 'NONE', nowIso } }];\n}\n\nreturn allItems.map(i => ({ json: i }));"
      },
