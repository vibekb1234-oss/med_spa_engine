            { "conditions": { "conditions": [{ "leftValue": "={{ $json.type }}", "rightValue": "REMINDER_48H", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "REMINDER_48H" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.type }}", "rightValue": "REMINDER_24H", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "REMINDER_24H" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.type }}", "rightValue": "NO_SHOW",      "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "NO_SHOW"      },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.type }}", "rightValue": "INQUIRY_FU",   "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "INQUIRY_FU"   },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.type }}", "rightValue": "POST_APPT",    "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "POST_APPT"    }
          ]
        },
        "options": {}
