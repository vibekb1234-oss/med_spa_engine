    {
      "parameters": {
        "sendTo": "={{ $json.clientEmail }}",
        "subject": "=⏰ Reminder: Your {{ $json.service }} appointment is in 2 days",
        "message": "=<!DOCTYPE html><html><body style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;color:#333;\">\n<div style=\"background:#be185d;color:white;padding:24px;border-radius:8px 8px 0 0;\"><h2 style=\"margin:0;\">⏰ Appointment Reminder</h2></div>\n<div style=\"background:#fdf4ff;padding:24px;border:1px solid #f0abfc;border-radius:0 0 8px 8px;\">\n  <p>Hi {{ $json.clientName }},</p>\n  <p>Just a friendly reminder that your <strong>{{ $json.service }}</strong> appointment is coming up!</p>\n  <div style=\"background:white;padding:16px;border-radius:8px;margin:20px 0;border-left:4px solid #be185d;\">\n    <strong>📅 Appointment Details:</strong><br/><br/>\n    Service: {{ $json.service }}<br/>\n    Date: {{ $json.apptDate }}<br/>\n    Time: {{ $json.apptTime }}<br/>\n    Provider: {{ $json.provider }}\n  </div>\n  <p><strong>Before your appointment:</strong></p>\n  <ul style=\"line-height:1.8;\">\n    <li>Arrive 5–10 minutes early to complete any forms</li>\n    <li>Come with a clean face (no heavy makeup if receiving facial treatments)</li>\n    <li>Stay hydrated — it helps with results</li>\n  </ul>\n  <p>If you need to reschedule, please reply to this email or call us at least 24 hours in advance.</p>\n  <p>We're looking forward to seeing you!<br/><strong>YOUR_CLINIC_NAME</strong></p>\n</div>\n</body></html>",
        "options": {}
      },
