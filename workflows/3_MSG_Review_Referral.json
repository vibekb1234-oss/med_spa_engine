{
  "name": "3 — MSG Review & Referral System",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "msg-appointment-complete",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "ms3000000-0000-0000-0000-000000000001",
      "name": "Webhook — Appointment Completed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "msg-appointment-complete-webhook"
    },
    {
      "parameters": {
        "jsCode": "// --- Webhook auth ---\nconst headers = $input.first().json.headers || {};\nconst secret = headers['x-webhook-secret'] || headers['X-Webhook-Secret'] || '';\nif (secret !== 'YOUR_WEBHOOK_SECRET') {\n  throw new Error('Unauthorized: invalid or missing X-Webhook-Secret header');\n}\n\nconst data = $input.first().json.body || $input.first().json;\nconst now  = new Date().toISOString();\n\n// Clinic calls this webhook when they mark an appointment as complete\n// POST body: { clientEmail, clientName, service, provider, googleReviewLink, totalVisits }\nreturn [{\n  json: {\n    clientEmail:       (data.clientEmail       || '').trim(),\n    clientName:        (data.clientName        || 'there').trim(),\n    service:           (data.service           || 'your treatment').trim(),\n    provider:          (data.provider          || 'our team').trim(),\n    googleReviewLink:  (data.googleReviewLink  || 'YOUR_GOOGLE_REVIEW_LINK').trim(),\n    totalVisits:        parseInt(data.totalVisits || 1),\n    nowIso: now\n  }\n}];"
      },
      "id": "ms3000000-0000-0000-0000-000000000002",
      "name": "Parse Completion Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "unit": "hours",
        "amount": 24
      },
      "id": "ms3000000-0000-0000-0000-000000000003",
      "name": "Wait 24 Hours",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [440, 0],
      "webhookId": "ms3000000-wait-webhook"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.clientEmail }}",
        "subject": "=⭐ How was your {{ $json.service }} experience?",
        "message": "=<!DOCTYPE html><html><body style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;color:#333;\">\n<div style=\"background:linear-gradient(135deg,#f59e0b,#d97706);color:white;padding:28px;border-radius:8px 8px 0 0;\">\n  <h2 style=\"margin:0;\">⭐ We'd Love Your Feedback</h2>\n</div>\n<div style=\"background:#fffbeb;padding:28px;border:1px solid #fde68a;border-radius:0 0 8px 8px;\">\n  <p>Hi {{ $json.clientName }},</p>\n  <p>It was a pleasure having you in yesterday for your <strong>{{ $json.service }}</strong>. We hope you're already loving the results!</p>\n\n  <div style=\"background:white;padding:20px;border-radius:8px;margin:20px 0;border-left:4px solid #f59e0b;text-align:center;\">\n    <p style=\"margin:0 0 12px;\"><strong>If you had a great experience, would you mind leaving us a Google review?</strong></p>\n    <p style=\"color:#6b7280;font-size:14px;margin:0 0 16px;\">It takes about 60 seconds and means the world to a small clinic like ours. Your review helps other people find trusted care.</p>\n    <a href=\"{{ $json.googleReviewLink }}\" style=\"background:#f59e0b;color:white;padding:14px 32px;border-radius:8px;text-decoration:none;font-weight:bold;font-size:16px;display:inline-block;\">⭐ Leave a Google Review →</a>\n  </div>\n\n  <p>Not completely satisfied? Please reply to this email directly — I personally read every message and would love the chance to make it right.</p>\n\n  <p>Thank you for choosing us for your care. We're looking forward to seeing you again!<br/><strong>{{ $json.provider }} &amp; the team at YOUR_CLINIC_NAME</strong></p>\n</div>\n</body></html>",
        "options": {}
      },
      "id": "ms3000000-0000-0000-0000-000000000004",
      "name": "Send Review Request",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [660, -120],
      "credentials": { "gmailOAuth2": { "id": "YOUR_GMAIL_CREDENTIAL_ID", "name": "Gmail account" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.totalVisits }}", "rightValue": 2, "operator": { "type": "number", "operation": "gte" } }],
          "combinator": "and"
        }
      },
      "id": "ms3000000-0000-0000-0000-000000000005",
      "name": "Returning Client? (2+ Visits)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 120]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.clientEmail }}",
        "subject": "=💌 A little thank-you — and a favour to ask",
        "message": "=<!DOCTYPE html><html><body style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;color:#333;\">\n<div style=\"background:linear-gradient(135deg,#be185d,#9333ea);color:white;padding:28px;border-radius:8px 8px 0 0;\">\n  <h2 style=\"margin:0;\">💌 Thank You for Being a Loyal Client</h2>\n</div>\n<div style=\"background:#fdf4ff;padding:28px;border:1px solid #f0abfc;border-radius:0 0 8px 8px;\">\n  <p>Hi {{ $json.clientName }},</p>\n  <p>This is your {{ $json.totalVisits === 2 ? 'second' : $json.totalVisits === 3 ? 'third' : $json.totalVisits + 'th' }} visit with us, and we genuinely love having you as a client. Thank you for your continued trust.</p>\n\n  <div style=\"background:white;padding:20px;border-radius:8px;margin:20px 0;border-left:4px solid #be185d;\">\n    <strong style=\"color:#be185d;\">💜 A small favour:</strong><br/><br/>\n    If you have friends, family, or colleagues who've mentioned wanting to try <strong>{{ $json.service }}</strong> (or any of our other treatments), we'd love the introduction.\n    <br/><br/>\n    As a thank-you, <strong>anyone you refer gets 15% off their first treatment</strong> — and you get a <strong>$50 credit</strong> toward your next visit for each friend who books.\n  </div>\n\n  <div style=\"background:#fce7f3;padding:16px;border-radius:8px;margin:20px 0;text-align:center;\">\n    <strong>To refer a friend:</strong><br/>\n    Simply forward this email to them, or have them mention your name when they book.<br/><br/>\n    <a href=\"mailto:YOUR_CLINIC_EMAIL@gmail.com\" style=\"background:#be185d;color:white;padding:10px 24px;border-radius:6px;text-decoration:none;font-weight:bold;display:inline-block;\">Refer a Friend →</a>\n  </div>\n\n  <p>Thank you again for being part of our community. We look forward to your next visit!<br/><strong>YOUR_CLINIC_NAME</strong></p>\n</div>\n</body></html>",
        "options": {}
      },
      "id": "ms3000000-0000-0000-0000-000000000006",
      "name": "Send Referral Ask",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [880, 0],
      "credentials": { "gmailOAuth2": { "id": "YOUR_GMAIL_CREDENTIAL_ID", "name": "Gmail account" } }
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "YOUR_MEDSPA_SHEET_ID", "mode": "id" },
        "sheetName":  { "__rl": true, "value": "Clients", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Client Email":      "={{ $json.clientEmail }}",
            "Review Requested":  "Yes",
            "Referral Asked":    "={{ $json.totalVisits >= 2 ? 'Yes' : 'No' }}",
            "Last Visit Date":   "={{ $json.nowIso }}",
            "Status":            "Completed"
          },
          "matchingColumns": ["Client Email"],
          "schema": []
        },
        "options": {}
      },
      "id": "ms3000000-0000-0000-0000-000000000007",
      "name": "Update Client Record",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1100, 0],
      "credentials": { "googleSheetsOAuth2Api": { "id": "YOUR_GSHEETS_CREDENTIAL_ID", "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "YOUR_MEDSPA_SHEET_ID", "mode": "id" },
        "sheetName":  { "__rl": true, "value": "Activity Log", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp":    "={{ $json.nowIso }}",
            "Client Email": "={{ $json.clientEmail }}",
            "Action Type":  "=Review Request",
            "Details":      "=Review request + referral ask sent to {{ $json.clientName }} (visit #{{ $json.totalVisits }}, service: {{ $json.service }})"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "ms3000000-0000-0000-0000-000000000008",
      "name": "Log Review + Referral",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1320, 0],
      "credentials": { "googleSheetsOAuth2Api": { "id": "YOUR_GSHEETS_CREDENTIAL_ID", "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"client\": \"{{ $('Parse Completion Data').first().json.clientName }}\", \"reviewScheduled\": true }"
      },
      "id": "ms3000000-0000-0000-0000-000000000009",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [220, 200]
    }
  ],
  "pinData": {},
